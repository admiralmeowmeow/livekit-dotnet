<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveKitScreenViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LiveKitScreenViewer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LiveKitScreenViewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#FF000000">
        <controls:VideoView x:Name="ViewerSurface" />

        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="880"
                Padding="14,10"
                CornerRadius="12"
                Background="#B0000000">
                <StackPanel Spacing="4">
                    <TextBlock Text="LiveKit Screen Viewer" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Incoming video is scaled to fit the available space while preserving the source aspect ratio."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="1200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12,10"
                    CornerRadius="12"
                    Background="#B0000000">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RenderStatusText" Text="Renderer starting..." FontWeight="SemiBold" />
                        <TextBlock x:Name="FeedStatusText" Text="Content: waiting for frames" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="LiveKitStatusText" Text="LiveKit: not connected yet" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="12,10"
                    CornerRadius="12"
                    Background="#B0000000">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BackendText" Text="Backend: initializing" />
                        <TextBlock x:Name="FpsText" Text="Render FPS: 0.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
